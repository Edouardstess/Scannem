{
    "name": "edouardstess/scannem",
    "description": "Cartes a QR code signees et verification a l'entree (usage unique)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-hash": "*",
        "ext-gd": "*",
        "endroid/qr-code": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Scannem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scannem\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public"
    }
}
