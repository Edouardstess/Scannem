# This directory must never be reachable over HTTP.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
# Only understood when PHP runs as an Apache module; elsewhere (PHP-FPM,
# CGI, most shared hosts) an unguarded php_flag is a 500 error.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
