# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. .env must never be committed.
# ---------------------------------------------------------------------------

APP_NAME="Studio"
APP_ENV=production

# Keep false in production. When true, stack traces are shown to visitors.
APP_DEBUG=false

# Full public URL, no trailing slash. Gallery links are built from this, so a
# wrong value produces links that do not work.
APP_URL=https://photographe.com

# Required. Generate with:  php bin/console.php key:generate
# Used to sign media URLs and to keep gallery links re-displayable.
APP_KEY=

APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr

# Set to true only when the application sits behind a reverse proxy you
# control; it makes X-Forwarded-For trusted for rate limiting and audit logs.
APP_TRUST_PROXY=false

# --- Database --------------------------------------------------------------
# mysql in production. sqlite exists for the test suite and local demos.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=photographer
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Only used when DB_CONNECTION=sqlite.
DB_SQLITE_PATH=

# --- Storage ---------------------------------------------------------------
# Absolute path to the private storage root. MUST be outside the document root.
# Leave empty to use <project>/storage/private.
STORAGE_PATH=

UPLOAD_MAX_BYTES=104857600
THUMBNAIL_WIDTH=400
PREVIEW_WIDTH=1600
PREVIEW_QUALITY=82
THUMBNAIL_QUALITY=78

# Écrit un WebP à côté de chaque JPEG et le sert aux navigateurs qui
# l'acceptent : environ deux tiers de poids en moins, pour environ un tiers de
# stockage de rendus en plus. Sans effet si le serveur ne sait pas le produire.
WEBP_ENABLED=true
WEBP_QUALITY=80

# Temporary ZIP archives are deleted after this many seconds.
ZIP_TTL_SECONDS=3600
ZIP_MAX_BYTES=4294967296

# --- Sessions and security -------------------------------------------------
SESSION_NAME=studio_session
SESSION_LIFETIME=7200

# Set to true once the site is served over HTTPS.
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Lifetime of a signed image URL, in seconds.
MEDIA_TOKEN_TTL=3600

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900
GALLERY_MAX_ATTEMPTS=10
CONTACT_MAX_PER_HOUR=5

# Enable only when HTTPS is fully configured, including every subdomain.
HSTS_ENABLED=false
CSP_REPORT_ONLY=false

# --- Mail ------------------------------------------------------------------
# log | mail | smtp
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@photographe.com
MAIL_FROM_NAME="Studio"
MAIL_TIMEOUT=15
